include README.md README_EN.md LICENSE requirements.txt CHANGELOG.md RELEASE_STATUS.json PUBLIC_MANIFEST.json
recursive-include mgmanet *.py
recursive-include docs *.md
recursive-include configs *.json
recursive-include examples *.md *.json *.png *.svg *.html
recursive-include tools *.py
recursive-include tests *.py
prune outputs
prune private
prune verification
prune build
prune dist
global-exclude *.py[cod] *.pth *.pt *.ckpt *.onnx *.pkl *.pickle *.whl *.so *.pyd *.o *.log
